# shorty on alpine（第 09 章候選之一）
#
#   docker build -f tutorials/09-base-images/Dockerfile.alpine -t shorty:ch09-alpine app

# ── build stage：四個版本都一樣，只換下面的 runtime base ─────────
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# CGO_ENABLED=0 → 純 Go 靜態執行檔，不依賴 libc，放進哪種 base 都能跑
# -trimpath 拿掉本機路徑；-s -w 拿掉符號表與除錯資訊（執行檔小約 30%）
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/shorty .

# ── runtime：alpine（musl libc + busybox）──────────────────
# 有 sh、wget，可以 docker exec 進去看；CA 憑證與 tzdata 用 apk 裝
FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/shorty /usr/local/bin/shorty
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/shorty"]
