# 第 14 章：shorty 的設定範本（給 docker run --env-file 用）
#
#   cp tutorials/14-config-secrets/shorty.env.example tutorials/14-config-secrets/shorty.env
#   # 編輯 shorty.env，把 CHANGE_ME 換成真的密碼
#   docker run -d --name shorty --network shorty-net -p 8080:8080 \
#     --env-file tutorials/14-config-secrets/shorty.env shorty
#
# shorty.env 已列在本目錄的 .gitignore，不會進 git；進 git 的只有這份 .example。
#
# docker run --env-file 的格式很陽春，跟 compose 的 .env 不一樣：
#   - 一行一個 KEY=VALUE，# 開頭的整行是註解
#   - 值「原封不動」：引號會變成值的一部分、不支援 ${VAR} 展開、不支援行尾註解
#   - 不要寫 export
#   - 存檔請用 LF 換行（Windows 編輯器存成 CRLF 時，每個值尾巴會多一個 \r）

# 監聽的 port（container 內）。改了這個，-p 的右邊也要跟著改
PORT=8080

# 回給使用者的短網址前綴：寫「外面的人」看得到的網址，不是 container 內的
BASE_URL=http://localhost:8080

# 沒設 → in-memory（重啟即消失）。db 是第 12 章 Postgres container 的名字
DATABASE_URL=postgres://shorty:CHANGE_ME@db:5432/shorty?sslmode=disable

# 沒設 → 不快取。cache 是 Redis container 的名字
REDIS_URL=redis://cache:6379/0

# debug / info / warn / error，看不懂的值會退回 info
LOG_LEVEL=info
