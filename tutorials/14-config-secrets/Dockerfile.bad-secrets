# syntax=docker/dockerfile:1
#
# 第 14 章：反面教材 —— 示範秘密「bake 進 image」之後，任何拿到 image 的人都看得到
# 不要照抄到真正的專案！
#
#   docker build -f tutorials/14-config-secrets/Dockerfile.bad-secrets \
#     --build-arg DB_PASSWORD=hunter2 -t bad-secrets app
#   docker history --no-trunc bad-secrets
#   docker image inspect bad-secrets --format '{{json .Config.Env}}'
#
# BuildKit 自己也會在 build 時警告：SecretsUsedInArgOrEnv

FROM alpine:3.22

# ❌ 用 ARG 傳密碼：RUN 用到它時，值會被記在 docker history 裡
ARG DB_PASSWORD

# ❌ 用 ENV 寫死 token：直接存在 image 的設定裡，每個 container 都繼承
ENV API_TOKEN=tok_live_51HxYzEXAMPLE

# ❌ 把秘密寫進檔案再刪掉：檔案還在上一層 layer 裡
RUN echo "password=${DB_PASSWORD}" > /tmp/app.conf
RUN rm /tmp/app.conf

CMD ["sh", "-c", "echo API_TOKEN=$API_TOKEN"]
