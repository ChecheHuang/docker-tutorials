# syntax=docker/dockerfile:1
#
# 第 11 章：secret mount 示範 —— 秘密只在這一個 RUN 期間存在，不進任何 layer
#
#   export DEMO_TOKEN=s3cr3t-value
#   docker build -f tutorials/11-buildkit/Dockerfile.secret-demo \
#     --secret id=demo_token,env=DEMO_TOKEN \
#     --progress=plain --no-cache -t secret-demo app
#   docker history --no-trunc secret-demo      # 找不到 s3cr3t-value
#   docker run --rm secret-demo                # /run/secrets/demo_token 不存在

FROM alpine:3.22

# 預設掛在 /run/secrets/<id>，只在這個 RUN 執行期間存在
# required=true：沒給 --secret 就直接 build 失敗，而不是默默用空值繼續
RUN --mount=type=secret,id=demo_token,required=true \
    echo "build 時讀得到 secret，長度 = $(wc -c < /run/secrets/demo_token) bytes"

# 也可以直接變成環境變數（只在這個 RUN 內有效，需要 dockerfile:1.10 以上前端）
RUN --mount=type=secret,id=demo_token,env=DEMO_TOKEN \
    test -n "$DEMO_TOKEN" && echo "env 形式也讀得到"

CMD ["sh", "-c", "ls -la /run/secrets 2>&1; echo \"DEMO_TOKEN=${DEMO_TOKEN:-<empty>}\""]
